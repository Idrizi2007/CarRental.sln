@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@* Account section at the bottom of the sidebar.
   Signed out: a Log in link. Signed in: the user's email, Change password, and Log out.
   Log out is a POST form rather than a link, because logging out changes state:
   the form tag helper adds an anti-forgery token, so another site can't log you out
   by embedding the URL somewhere. *@

<div class="sidebar-heading">Account</div>

@if (SignInManager.IsSignedIn(User))
{
    <span class="sidebar-user" title="@User.Identity?.Name">@User.Identity?.Name</span>

    <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword">Change password</a>

    <form asp-area="Identity" asp-page="/Account/Logout"
          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "Customer" })"
          method="post">
        <button type="submit" class="sidebar-button">Log out</button>
    </form>
}
else
{
    <a asp-area="Identity" asp-page="/Account/Login">Log in</a>
}
