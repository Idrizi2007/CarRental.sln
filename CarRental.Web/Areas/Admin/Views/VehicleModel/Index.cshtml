@{
    ViewData["Title"] = "Models";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Models</h1>
    <a asp-controller="VehicleModel" asp-action="Upsert" class="btn btn-primary">Add New</a>
</div>

@* Rows come from /Admin/VehicleModel/GetAll — see wwwroot/js/vehicle-model.js.
   The <thead> columns must match the columns array in the JS, same order. *@
<table id="tblVehicleModels" class="table table-striped table-hover w-100">
    <thead>
        <tr>
            <th>Model</th>
            <th>Brand</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
</table>

@section Scripts {
    <script src="~/js/vehicle-model.js" asp-append-version="true"></script>
}
