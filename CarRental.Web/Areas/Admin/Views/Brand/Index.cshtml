@{
    ViewData["Title"] = "Brands";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Brands</h1>
    <a asp-controller="Brand" asp-action="Upsert" class="btn btn-primary">Add New</a>
</div>

@* Rows are loaded by DataTables from /Admin/Brand/GetAll — see wwwroot/js/brand.js.
   The tbody is left empty on purpose; the <thead> columns must match the
   columns array in the JS, in the same order. *@
<table id="tblBrands" class="table table-striped table-hover w-100">
    <thead>
        <tr>
            <th>Name</th>
            <th>Logo</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
</table>

@section Scripts {
    <script src="~/js/brand.js" asp-append-version="true"></script>
}
