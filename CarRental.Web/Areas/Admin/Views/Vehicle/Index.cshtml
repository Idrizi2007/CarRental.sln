@{
    ViewData["Title"] = "Vehicles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Vehicles</h1>
    <a asp-controller="Vehicle" asp-action="Upsert" class="btn btn-primary">Add New</a>
</div>

@* Rows come from /Admin/Vehicle/GetAll — see wwwroot/js/vehicle.js.
   The <thead> columns must match the columns array in the JS, same order. *@
<table id="tblVehicles" class="table table-striped table-hover w-100">
    <thead>
        <tr>
            <th>Plate</th>
            <th>Car</th>
            <th>Category</th>
            <th>Rent / day</th>
            <th>Sale price</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
</table>

@section Scripts {
    <script src="~/js/vehicle.js" asp-append-version="true"></script>
}
