@{
    ViewData["Title"] = "Vehicles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Vehicles</h1>
    <a asp-controller="Vehicle" asp-action="Upsert" class="btn btn-primary">Add New</a>
</div>

@* Client-side search. The full list is already in the browser after GetAll,
   so filtering happens in JS with no extra request. *@
<div class="row g-2 align-items-center mb-4">
    <div class="col-md-6">
        <input type="search" id="vehicleSearch" class="form-control"
               placeholder="Search by plate, brand or model..." autocomplete="off" />
    </div>
    <div class="col-md-6 text-md-end">
        <span class="text-muted small" id="vehicleCount"></span>
    </div>
</div>

@* Cards are rendered by wwwroot/js/vehicle.js from /Admin/Vehicle/GetAll. *@
<div class="row g-4" id="vehicleGrid"></div>

<div id="vehicleEmpty" class="text-center text-muted py-5" hidden>
    <p class="mb-1">No vehicles match that search.</p>
</div>

@section Scripts {
    <script src="~/js/vehicle.js" asp-append-version="true"></script>
}
