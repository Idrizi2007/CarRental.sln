@model IEnumerable<Feature>

@{
    ViewData["Title"] = "Features";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Features</h1>
    <a asp-controller="Feature" asp-action="Upsert" class="btn btn-primary">Add New</a>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var feature in Model)
        {
            <tr>
                <td>@feature.Name</td>
                <td>
                    @if (feature.IsActive)
                    {
                        <span class="badge bg-success">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No</span>
                    }
                </td>
                <td>
                    <a asp-controller="Feature" asp-action="Upsert" asp-route-id="@feature.Id" class="btn btn-sm btn-secondary">Edit</a>
                    <button type="button" class="btn btn-sm btn-danger"
                            onclick="confirmDelete('@Url.Action("Delete", "Feature", new { area = "Admin", id = feature.Id })', '@feature.Name')">
                        Delete
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>
